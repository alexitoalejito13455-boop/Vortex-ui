local function Button(parent,text,cb)
	local b=Instance.new("TextButton")
	b.Size=UDim2.new(1,0,0,58)
	b.BackgroundColor3=ButtonBaseColor()
	b.TextColor3=ButtonTextColor()
	b.Text=text
	b.TextTransparency=1
	b.Font=Enum.Font.GothamSemibold
	b.TextSize=12
	b.AutoButtonColor=false
	b.Parent=parent
	Corner(b,10)

	local s=Instance.new("UIStroke",b)
	s.Transparency=.72
	s.Thickness=1
	s.Color=Accent()

	local iconBox=Instance.new("Frame")
	iconBox.Name="IconBox"
	iconBox.Size=UDim2.fromOffset(40,40)
	iconBox.Position=UDim2.fromOffset(9,9)
	iconBox.BackgroundColor3=Custom("Icon", Accent())
	iconBox.BackgroundTransparency=.72
	iconBox.BorderSizePixel=0
	iconBox.Parent=b
	Corner(iconBox,10)
	Reg("Icons",iconBox)

	local icon=Instance.new("TextLabel")
	icon.Name="ButtonIcon"
	icon.Size=UDim2.fromScale(1,1)
	icon.BackgroundTransparency=1
	icon.Text=ButtonIcon(text)
	icon.Font=Enum.Font.GothamBlack
	icon.TextSize=19
	icon.TextColor3=Color3.new(1,1,1)
	icon.Parent=iconBox
	Reg("AccentLabels",icon)

	local title=Instance.new("TextLabel")
	title.Name="ButtonTitle"
	title.BackgroundTransparency=1
	title.Position=UDim2.fromOffset(59,7)
	title.Size=UDim2.new(1,-145,0,22)
	title.TextColor3=ButtonTextColor()
	title.Text=select(2,text:match("^(%S+)%s*(.*)$")) or text
	if title.Text=="" then title.Text=text end
	title.Font=Enum.Font.GothamBold
	title.TextSize=12
	title.TextXAlignment=Enum.TextXAlignment.Left
	title.TextTruncate=Enum.TextTruncate.AtEnd
	title.Parent=b
	Reg("Labels",title)

	local desc=Instance.new("TextLabel")
	desc.Name="ButtonDesc"
	desc.BackgroundTransparency=1
	desc.Position=UDim2.fromOffset(59,29)
	desc.Size=UDim2.new(1,-145,0,18)
	desc.Text="VORTEX ACTION  •  Toca para usar"
	desc.Font=Enum.Font.Gotham
	desc.TextSize=9
	desc.TextColor3=Accent()
	desc.TextXAlignment=Enum.TextXAlignment.Left
	desc.TextTruncate=Enum.TextTruncate.AtEnd
	desc.Parent=b
	Reg("AccentLabels",desc)

	local arrow=Instance.new("TextLabel")
	arrow.Name="ButtonArrow"
	arrow.BackgroundTransparency=1
	arrow.AnchorPoint=Vector2.new(1,.5)
	arrow.Position=UDim2.new(1,-12,.5,0)
	arrow.Size=UDim2.fromOffset(24,24)
	arrow.Text="›"
	arrow.Font=Enum.Font.GothamBold
	arrow.TextSize=22
	arrow.TextColor3=Accent()
	arrow.Parent=b
	Reg("AccentLabels",arrow)

	Reg("Buttons",b); Reg("Strokes",s)
	b.Activated:Connect(function() if cb then cb(b) end end)
	return b
end
local function Label(parent,text)
	local l=Instance.new("TextLabel"); l.Size=UDim2.new(1,0,0,27); l.BackgroundTransparency=1; l.Text=text; l.Font=Enum.Font.GothamBold; l.TextSize=13; l.TextXAlignment=Enum.TextXAlignment.Left; l.Parent=parent; Reg("Labels",l); return l
end
local function Toggle(parent,text,key,cb)
	local b
	b=Button(parent,text,function()
		State[key]=not State[key]
		SetButtonText(b,text..": "..(State[key] and "ON" or "OFF"))
		b.BackgroundColor3=State[key] and ButtonOnColor() or ButtonOffColor()
		if cb then cb(State[key]) end
	end)
	b:SetAttribute("VortexToggle",true)
	SetButtonText(b,text..": "..(State[key] and "ON" or "OFF"))
	b.BackgroundColor3=State[key] and ButtonOnColor() or ButtonOffColor()
	return b
end
local function OpenPage(n)
	for _,p in pairs(Pages) do p.Visible=false end
	Pages[n].Visible=true; State.CurrentPage=n
end

