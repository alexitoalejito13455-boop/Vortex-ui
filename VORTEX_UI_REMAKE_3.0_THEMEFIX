local function RemovePlayerESP(p)
	if p==LP then return end
	local c=p.Character;if not c then return end
	local old=c:FindFirstChild("VortexESP");if old then old:Destroy() end
end
local function UpdateESP(p)
	if p==LP then return end
	local c=p.Character;if not c then return end
	local old=c:FindFirstChild("VortexESP")
	if State.ESP then
		if not old then old=Instance.new("Highlight");old.Name="VortexESP";old.FillTransparency=.65;old.OutlineTransparency=.1;old.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop;old.Parent=c end
		old.FillColor=Accent();old.OutlineColor=Accent()
	elseif old then old:Destroy() end
end
local function RemoveAllESP()
	State.ESP=false
	for _,p in ipairs(Players:GetPlayers()) do RemovePlayerESP(p) end
end
for _,p in ipairs(Players:GetPlayers()) do
	if p~=LP then p.CharacterAdded:Connect(function() task.wait(.25);UpdateESP(p) end) end
end
Players.PlayerAdded:Connect(function(p)
	p.CharacterAdded:Connect(function() task.wait(.25);UpdateESP(p) end)
end)


--========================================================
-- VORTEX BODY SIZE
--========================================================

local BodySizeMultipliers = {
    SMALL = 0.6,
    NORMAL = 1,
    BIG = 1.6
}

local function SetBodySize(mode)
    mode = string.upper(tostring(mode))
    local multiplier = BodySizeMultipliers[mode]
    if not multiplier then return false end

    State.BodySize = mode

    local character = LP.Character
    if not character then return false end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end

    -- R15: scale the avatar using its native body scale values.
    local scaleNames = {
        "BodyDepthScale",
        "BodyHeightScale",
        "BodyWidthScale",
        "HeadScale"
    }

    local changed = false
    for _, name in ipairs(scaleNames) do
        local scale = humanoid:FindFirstChild(name)
        if scale and scale:IsA("NumberValue") then
            scale.Value = multiplier
            changed = true
        end
    end

    -- R6: resize body parts directly because R6 has no R15 scale values.
    if not changed then
        local parts = {
            "Head", "Torso",
            "Left Arm", "Right Arm",
            "Left Leg", "Right Leg"
        }

        for _, name in ipairs(parts) do
            local part = character:FindFirstChild(name)
            if part and part:IsA("BasePart") then
                part.Size = part:GetAttribute("VortexOriginalSize") or part.Size
                if not part:GetAttribute("VortexOriginalSize") then
                    part:SetAttribute("VortexOriginalSize", part.Size)
                end
                part.Size = part:GetAttribute("VortexOriginalSize") * multiplier
            end
        end
    end

    return true
end

local function ResetBodySize()
    return SetBodySize("NORMAL")
end

LP.CharacterAdded:Connect(function()
    task.wait(0.5)
    SetBodySize(State.BodySize)
end)

--========================================================
-- VORTEX BODY SHAPES
--========================================================

local BodyShapeProfiles = {
    NORMAL = {
        torso = Vector3.new(2, 2, 1),
        head = 1,
        arm = Vector3.new(1, 2, 1),
        leg = Vector3.new(1, 2, 1)
    },
    FAT = {
        torso = Vector3.new(3.4, 2.5, 1.7),
        head = 1.35,
        arm = Vector3.new(1.35, 2.2, 1.35),
        leg = Vector3.new(1.15, 2, 1.15)
    },
    SKINNY = {
        torso = Vector3.new(0.75, 2.2, 0.55),
        head = 0.8,
        arm = Vector3.new(0.55, 2.15, 0.55),
        leg = Vector3.new(0.6, 2.15, 0.6)
    }
}

local function ApplyBodyShapeR6(character, profile)
    local map = {
        Torso = profile.torso,
        ["Left Arm"] = profile.arm,
        ["Right Arm"] = profile.arm,
        ["Left Leg"] = profile.leg,
        ["Right Leg"] = profile.leg
    }

    for name, size in pairs(map) do
        local part = character:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            local original = part:GetAttribute("VortexShapeOriginalSize")
            if not original then
                original = part.Size
                part:SetAttribute("VortexShapeOriginalSize", original)
            end
            part.Size = original * Vector3.new(
                size.X / 1,
                size.Y / 2,
                size.Z / 1
            )
        end
    end

    local head = character:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        local original = head:GetAttribute("VortexShapeOriginalSize")
        if not original then
            original = head.Size
            head:SetAttribute("VortexShapeOriginalSize", original)
        end
        head.Size = original * profile.head
    end
end

local function ApplyBodyShape(mode)
    mode = string.upper(tostring(mode))
    local profile = BodyShapeProfiles[mode]
    if not profile then return false end

    State.BodyShape = mode

    local character = LP.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not humanoid then return false end

    -- R15: use native body scale values where available.
    if humanoid:FindFirstChild("BodyWidthScale") then
        local width = humanoid:FindFirstChild("BodyWidthScale")
        local depth = humanoid:FindFirstChild("BodyDepthScale")
        local height = humanoid:FindFirstChild("BodyHeightScale")
        local head = humanoid:FindFirstChild("HeadScale")

        if mode == "FAT" then
            width.Value = 1.65
            if depth then depth.Value = 1.45 end
            if height then height.Value = 1.1 end
            if head then head.Value = 1.3 end
        elseif mode == "SKINNY" then
            width.Value = 0.55
            if depth then depth.Value = 0.6 end
            if height then height.Value = 1.05 end
            if head then head.Value = 0.8 end
        else
            width.Value = 1
            if depth then depth.Value = 1 end
            if height then height.Value = 1 end
            if head then head.Value = 1 end
        end

        return true
    end

    -- R6 fallback.
    ApplyBodyShapeR6(character, profile)
    return true
end

LP.CharacterAdded:Connect(function()
    task.wait(0.5)
    ApplyBodyShape(State.BodyShape)
end)

--========================================================
-- VORTEX LASER GUN + GOD MODE
--========================================================

local GodMode = false

local function ApplyGodMode()
	if not GodMode then
		return
	end

	local character = LP.Character
	local hum = character and character:FindFirstChildOfClass("Humanoid")

	if hum then
		pcall(function()
			hum.MaxHealth = math.huge
			hum.Health = hum.MaxHealth
		end)
	end
end

local function RemoveVortexLaser()
	local backpack = LP:FindFirstChildOfClass("Backpack")

	if backpack then
		local old = backpack:FindFirstChild("Vortex Laser Gun")
		if old then
			old:Destroy()
		end
	end

	local character = LP.Character

	if character then
		local old = character:FindFirstChild("Vortex Laser Gun")
		if old then
			old:Destroy()
		end
	end
end

local function CreateVortexLaser()
	RemoveVortexLaser()

	local gun = Instance.new("Tool")
	gun.Name = "Vortex Laser Gun"
	gun.RequiresHandle = true
	gun.CanBeDropped = false
	gun.ToolTip = "Vortex Laser Gun"
	gun.Parent = LP:WaitForChild("Backpack")

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.5, 1, 3)
	handle.Material = Enum.Material.Neon
	handle.Color = Color3.fromRGB(255, 0, 0)
	handle.CanCollide = false
	handle.CanTouch = false
	handle.CanQuery = false
	handle.Massless = true
	handle.Transparency = 1
	handle.Parent = gun
	local function gunPart(name,size,cf,color,material)
		local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=cf;p.Color=color;p.Material=material or Enum.Material.Metal;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Massless=true;p.Parent=gun
		local w=Instance.new("WeldConstraint",p);w.Part0=handle;w.Part1=p;return p
	end
	local body=gunPart("Body",Vector3.new(.8,.8,1.7),handle.CFrame,Color3.fromRGB(38,42,52),Enum.Material.Metal)
	local grip=gunPart("Grip",Vector3.new(.55,1.1,.65),handle.CFrame*CFrame.new(0,-.65,.25)*CFrame.Angles(math.rad(-12),0,0),Color3.fromRGB(25,27,34),Enum.Material.Metal)
	local barrel=gunPart("Barrel",Vector3.new(.34,.34,1.55),handle.CFrame*CFrame.new(0,0,-1.35),Color3.fromRGB(75,80,92),Enum.Material.Metal)
	local core=gunPart("EnergyCore",Vector3.new(.42,.42,.65),handle.CFrame*CFrame.new(0,0,-2.05),Accent(),Enum.Material.Neon)
	local ring=gunPart("EnergyRing",Vector3.new(.7,.7,.18),handle.CFrame*CFrame.new(0,0,-1.72),Accent(),Enum.Material.Neon)
	local muzzle=gunPart("Muzzle",Vector3.new(.52,.52,.18),handle.CFrame*CFrame.new(0,0,-2.42),Color3.fromRGB(255,255,255),Enum.Material.Neon)

	local shootSound = Instance.new("Sound")
	shootSound.Name = "ShootSound"
	shootSound.SoundId = "rbxassetid://130113322"
	shootSound.Volume = 2
	shootSound.Parent = handle

	gun.Activated:Connect(function()
		local mouse = LP:GetMouse()
		local root = Root()

		if not mouse then
			return
		end

		local targetPos = mouse.Hit.Position

		shootSound:Play()

		local exp = Instance.new("Explosion")
		exp.Position = targetPos
		exp.BlastRadius = 10
		exp.BlastPressure = 0
		exp.DestroyJointRadiusPercent = 0
		exp.Parent = workspace

		if root then
			local distance = (targetPos - root.Position).Magnitude

			if distance < 10 then
				local velocity = Instance.new("BodyVelocity")
				velocity.Velocity = Vector3.new(0, 100, 0)
				velocity.MaxForce = Vector3.new(0, math.huge, 0)
				velocity.Parent = root

				task.delay(0.15, function()
					if velocity and velocity.Parent then
						velocity:Destroy()
					end
				end)
			end
		end

		local startPos = handle.Position
		local distance = (targetPos - startPos).Magnitude

		if distance > 0 then
			local tracer = Instance.new("Part")
			tracer.Name = "VortexLaserTracer"
			tracer.Anchored = true
			tracer.CanCollide = false
			tracer.CanTouch = false
			tracer.CanQuery = false
			tracer.Material = Enum.Material.Neon
			tracer.Color = Color3.fromRGB(255, 255, 0)
			tracer.Size = Vector3.new(0.2, 0.2, distance)
			tracer.CFrame =
				CFrame.lookAt(startPos, targetPos) *
				CFrame.new(0, 0, -distance / 2)
			tracer.Parent = workspace

			task.delay(0.05, function()
				if tracer and tracer.Parent then
					tracer:Destroy()
				end
			end)
		end
	end)

	return gun
end

ToolToggle(
	"VISUAL",
	"🛡️ GOD MODE",
	"GodMode",
	function(enabled)
		GodMode = enabled

		if enabled then
			ApplyGodMode()
		end
	end
)

ToolButton(
	"PHYSICAL",
	"🔴 LASER GUN",
	function()
		local backpack = LP:FindFirstChildOfClass("Backpack")
		local character = LP.Character

		local existing =
			(backpack and backpack:FindFirstChild("Vortex Laser Gun"))
			or (character and character:FindFirstChild("Vortex Laser Gun"))

		if existing then
			Notify("VORTEX", "Laser Gun ya está disponible 🔴")
			return
		end

		CreateVortexLaser()
		Notify("VORTEX", "Laser Gun creada 🔴")
	end
)

LP.CharacterAdded:Connect(function()
	task.wait(0.25)

	if GodMode then
		ApplyGodMode()
	end
end)

RunService.Heartbeat:Connect(function(dt)
	if GodMode then ApplyGodMode() end

	if GodMode then
		ApplyGodMode()
	end
	local h=Humanoid();local r=Root()
	if h then h.WalkSpeed=State.Sprint and State.Speed*1.5 or State.Speed;h.JumpPower=State.JumpPower end
	if State.Noclip and Character() then for _,p in ipairs(Character():GetDescendants())do if p:IsA("BasePart")then p.CanCollide=false end end end
	if State.Fly and r then if not FlyVelocity or not FlyVelocity.Parent then StartFly()end;if FlyVelocity then FlyVelocity.VectorVelocity=FlyDirection()*State.FlySpeed end end
	if not State.Fly and FlyVelocity then StopFly()end
	FPS.Text="FPS: "..math.floor(1/math.max(dt,.001));PC.Text="PLAYERS: "..#Players:GetPlayers();Session.Text="SESSION: "..math.floor(os.clock()-State.Session).."s"
	Input.Text="INPUT: "..(UIS.TouchEnabled and(UIS.KeyboardEnabled and"TOUCH + PC"or"MOBILE")or"PC")
	UIScale.Scale=(State.Device=="MOBILE" and .82 or 1)*State.Scale
	if State.RGB then ApplyTheme()end
	if State.RGB then
		for _,p in ipairs(LP:GetDescendants()) do if p.Name=="EnergyCore" or p.Name=="EnergyRing" then p.Color=Accent() end end
	end
	if State.ESP then for _,p in ipairs(Players:GetPlayers())do UpdateESP(p)end end
end)

local Profiles = {}
local function SnapshotProfile()
	local cc={}
	for k,v in pairs(State.CustomColors or {}) do cc[k]=v end
	return {Speed=State.Speed,JumpPower=State.JumpPower,FlySpeed=State.FlySpeed,HoverSpeed=State.HoverSpeed,BodySize=State.BodySize,BodyShape=State.BodyShape,Theme=State.Theme,Scale=State.Scale,Transparency=State.Transparency,RGB=State.RGB,CustomColors=cc}
end
local function ApplyProfile(data) if not data then return end;for k,v in pairs(data) do State[k]=v end;if State.Theme and Themes[State.Theme] then ApplyTheme() end;if State.BodySize then SetBodySize(State.BodySize) end;if State.BodyShape then ApplyBodyShape(State.BodyShape) end;Notify("PROFILES","Perfil cargado ⭐") end
local function SaveProfile(name) if not name or name=="" then return end;Profiles[name]=SnapshotProfile();Notify("PROFILES","Guardado: "..name.." 💾") end
local function LoadProfile(name) if Profiles[name] then ApplyProfile(Profiles[name]) else Notify("PROFILES","No existe: "..name) end end
Label(ProfilesPage,"⭐ PROFILES")
local ProfileNameBox=Instance.new("TextBox");ProfileNameBox.Size=UDim2.new(1,0,0,44);ProfileNameBox.BackgroundColor3=ButtonBaseColor();ProfileNameBox.TextColor3=ButtonTextColor();ProfileNameBox.PlaceholderText="Nombre del perfil...";ProfileNameBox.ClearTextOnFocus=false;ProfileNameBox.Font=Enum.Font.Gotham;ProfileNameBox.TextSize=13;ProfileNameBox.Parent=ProfilesPage;Corner(ProfileNameBox,10);Reg("TextBoxes",ProfileNameBox)
Button(ProfilesPage,"💾 SAVE PROFILE",function() SaveProfile(ProfileNameBox.Text) end)
Button(ProfilesPage,"📂 LOAD PROFILE",function() LoadProfile(ProfileNameBox.Text) end)
Button(ProfilesPage,"⚡ SAVE FAST",function() SaveProfile("Fast") end)
Button(ProfilesPage,"🛹 SAVE HOVER",function() SaveProfile("Hover") end)
Button(ProfilesPage,"🧪 SAVE PHYSICS",function() SaveProfile("Physics") end)
Button(ProfilesPage,"🎭 SAVE FUN",function() SaveProfile("Fun") end)
Button(ProfilesPage,"🗑 DELETE PROFILE",function() if Profiles[ProfileNameBox.Text] then Profiles[ProfileNameBox.Text]=nil;Notify("PROFILES","Perfil eliminado 🗑") end end)


