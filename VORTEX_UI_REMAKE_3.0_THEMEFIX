--========================================================
-- DESTROY UI
--========================================================
local VortexDestroyed = false
local function DestroyVortexUI()
	if VortexDestroyed then return end
	VortexDestroyed = true

	pcall(function() SetFly(false) end)
	pcall(function() StopSpectator() end)
	pcall(function() RemoveAllESP() end)

	-- Remove only Vortex UI objects/panels.
	pcall(function()
		if GUI then GUI:Destroy() end
	end)
end

-- Slider / button control helpers
local function MakeSlider(parent,labelText,minValue,maxValue,getValue,setValue,step)
	local frame=Instance.new("Frame")
	frame.Size=UDim2.new(1,0,0,72)
	frame.BackgroundColor3=Themes[State.Theme].BUTTON
	frame.BorderSizePixel=0
	frame.Parent=parent
	Corner(frame,10)
	Reg("Panels",frame)
	local label=Instance.new("TextLabel")
	label.BackgroundTransparency=1; label.Position=UDim2.fromOffset(12,7); label.Size=UDim2.new(1,-90,0,20)
	label.Text=labelText; label.Font=Enum.Font.GothamBold; label.TextSize=11; label.TextXAlignment=Enum.TextXAlignment.Left; label.Parent=frame; Reg("Labels",label)
	local value=Instance.new("TextLabel")
	value.BackgroundTransparency=1; value.AnchorPoint=Vector2.new(1,0); value.Position=UDim2.new(1,-12,0,7); value.Size=UDim2.fromOffset(70,20)
	value.Font=Enum.Font.GothamBold; value.TextSize=11; value.TextXAlignment=Enum.TextXAlignment.Right; value.Parent=frame; Reg("AccentLabels",value)
	local bar=Instance.new("Frame"); bar.Size=UDim2.new(1,-24,0,8); bar.Position=UDim2.fromOffset(12,42); bar.BorderSizePixel=0; bar.Parent=frame; Corner(bar,4); Reg("Strokes",Instance.new("UIStroke",bar))
	local fill=Instance.new("Frame"); fill.BorderSizePixel=0; fill.Parent=bar; Corner(fill,4); Reg("AccentFrames",fill)
	local knob=Instance.new("TextButton"); knob.AutoButtonColor=false; knob.Text=""; knob.Size=UDim2.fromOffset(20,20); knob.AnchorPoint=Vector2.new(.5,.5); knob.Position=UDim2.fromScale(0,.5); knob.Parent=bar; Corner(knob,10); Reg("Buttons",knob)
	local draggingSlider=false
	local function refresh(v)
		v=math.clamp(v,minValue,maxValue); setValue(v); value.Text=tostring(math.floor(v)); local pct=(v-minValue)/(maxValue-minValue); fill.Size=UDim2.new(pct,0,1,0); knob.Position=UDim2.new(pct,0,.5,0)
	end
	local function setFromX(x)
		local pct=math.clamp((x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1); local v=minValue+(maxValue-minValue)*pct; if step then v=math.round(v/step)*step end; refresh(v)
	end
	bar.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then draggingSlider=true; setFromX(i.Position.X) end end)
	knob.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then draggingSlider=true end end)
	UIS.InputChanged:Connect(function(i) if draggingSlider and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then setFromX(i.Position.X) end end)
	UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then draggingSlider=false end end)
	refresh(getValue())
	return frame,refresh
end

local function AddAdjustSlider(parent,labelText,minValue,maxValue,getter,setter,step)
	if State.ControlsMode=="SLIDERS" then return MakeSlider(parent,labelText,minValue,maxValue,getter,setter,step) end
	local b=Button(parent,labelText,function() end)
	return b
end

-- Settings
Label(SettingsPage,"🎨 APPEARANCE")
local ThemeButton;local RGBButton
local function ApplyTheme()
	local th=Themes[State.Theme] or Themes["Vortex Blue"]
	local a=Accent()

	-- Fondo principal
	Main.BackgroundColor3=th.BG
	Main.BackgroundTransparency=State.Transparency

	-- Paneles principales: sidebar, contenido y header
	for _,o in ipairs(Registry.Panels)do
		if o.Parent then
			o.BackgroundColor3=Custom("Panel", th.PANEL)
		end
	end

	-- Tarjetas/botones: cada tema cambia tambien su contraste
	for _,o in ipairs(Registry.Buttons)do
		if o.Parent then
			local sel=o.Name=="Category_"..State.CurrentToolCategory
			local isToggle=o:GetAttribute("VortexToggle")
			local isOn=isToggle and o.Text:find(": ON",1,true)~=nil
			o.BackgroundColor3=sel and CategoryActiveColor() or (o.Name:sub(1,9)=="Category_" and CategoryInactiveColor() or (isToggle and (isOn and ButtonOnColor() or ButtonOffColor()) or ButtonBaseColor()))
			o.TextColor3=sel and Color3.new(1,1,1) or ButtonTextColor()
		end
	end

	-- Textos principales
	for _,o in ipairs(Registry.Labels)do
		if o.Parent then
			o.TextColor3=th.TEXT
		end
	end

	-- Textos secundarios/iconos/flechas
	for _,o in ipairs(Registry.AccentLabels)do
		if o.Parent then
			o.TextColor3=a
		end
	end
	for _,o in ipairs(Registry.AccentFrames)do
		if o.Parent then o.BackgroundColor3=a end
	end

	-- Cajas de búsqueda y texto
	for _,o in ipairs(Registry.TextBoxes)do
		if o.Parent then
			o.BackgroundColor3=Custom("Panel", th.BG)
			o.TextColor3=Custom("Text", th.TEXT)
			o.PlaceholderColor3=a
		end
	end

	-- Bordes: RGB usa el acento animado; temas normales usan un borde propio
	for _,o in ipairs(Registry.Strokes)do
		if o.Parent then
			o.Color=BorderColor()
		end
	end

	-- Cuadros de iconos: el fondo es una variante del color del tema
	for _,o in ipairs(Registry.Icons)do
		if o.Parent then
			o.BackgroundColor3=Custom("Icon", State.RGB and a or th.ICONBG)
			o.BackgroundTransparency=.70
		end
	end

	-- Descripciones de las tarjetas usan el tono secundario
	for _,page in pairs(Pages)do
		if page and page.Parent then
			for _,o in ipairs(page:GetDescendants())do
				if o:IsA("TextLabel") and o.Name=="ButtonDesc" then
					o.TextColor3=State.RGB and a or th.MUTED
				end
			end
		end
	end

	ThemeLabel.Text="THEME • "..State.Theme
	ThemeLabel.TextColor3=a
	local hoverGui=PG:FindFirstChild("VortexHoverControls")
	if hoverGui then
		local panel=hoverGui:FindFirstChildOfClass("Frame")
		if panel then
			panel.BackgroundColor3=Custom("Panel",th.PANEL)
			for _,o in ipairs(panel:GetChildren()) do
				if o:IsA("TextButton") then o.BackgroundColor3=ButtonBaseColor(); o.TextColor3=ButtonTextColor() end
				if o:IsA("UIStroke") then o.Color=BorderColor() end
			end
		end
	end
end
