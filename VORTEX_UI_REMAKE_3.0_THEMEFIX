	["Legacy"]={BG=Color3.fromRGB(10,10,10),PANEL=Color3.fromRGB(18,18,18),BUTTON=Color3.fromRGB(27,27,27),ACCENT=Color3.fromRGB(210,45,45),TEXT=Color3.fromRGB(235,235,235),MUTED=Color3.fromRGB(175,105,105),ICONBG=Color3.fromRGB(125,30,30),STROKE=Color3.fromRGB(155,35,35)}
}

local function Character() return LP.Character end
local function Humanoid()
	local c=Character(); return c and c:FindFirstChildOfClass("Humanoid")
end
local function Root()
	local c=Character(); return c and c:FindFirstChild("HumanoidRootPart")
end
local function Notify(t,x,d)
	pcall(function() StarterGui:SetCore("SendNotification",{Title=t,Text=x,Duration=d or 3}) end)
end
local function Corner(o,r)
	local c=Instance.new("UICorner"); c.CornerRadius=UDim.new(0,r or 8); c.Parent=o; return c
end
local function Accent()
	if State.RGB then return Color3.fromHSV((os.clock()%5)/5,1,1) end
	return Themes[State.Theme].ACCENT
end
local function Custom(name, fallback)
    local c=State.CustomColors and State.CustomColors[name]
    return (State.CustomColors and State.CustomColors.Enabled and c) or fallback
end
local function ButtonBaseColor() return Custom("Button", Themes[State.Theme].BUTTON) end
local function ButtonTextColor() return Custom("ButtonText", Themes[State.Theme].TEXT) end
local function CategoryInactiveColor() return Custom("CategoryInactive", Themes[State.Theme].BUTTON) end
local function CategoryActiveColor() return Custom("CategoryActive", Accent()) end
local function BorderColor() return Custom("Border", State.RGB and Accent() or Themes[State.Theme].STROKE) end
local function ButtonOnColor()
	local th=Themes[State.Theme] or Themes["Vortex Blue"]
	if State.CustomColors and State.CustomColors.Enabled and State.CustomColors.ButtonOn then return State.CustomColors.ButtonOn end
	-- ON sigue el tema: mezcla el color base con el acento, sin verde fijo.
	return State.RGB and Accent() or th.BUTTON:Lerp(th.ACCENT,0.55)
end
local function ButtonOffColor()
	local th=Themes[State.Theme] or Themes["Vortex Blue"]
	if State.CustomColors and State.CustomColors.Enabled and State.CustomColors.ButtonOff then return State.CustomColors.ButtonOff end
	-- OFF sigue el tema y conserva contraste, sin rojo/gris fijo.
	return th.BUTTON:Lerp(th.BG,0.45)
end

