ThemeButton=Button(SettingsPage,"🎨 THEME: "..State.Theme,function()
	local i=table.find(themeList,State.Theme)or 1;i=i%#themeList+1;State.Theme=themeList[i];SetButtonText(ThemeButton,"🎨 THEME: "..State.Theme);ApplyTheme()
end)
