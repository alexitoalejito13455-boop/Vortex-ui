	["Crimson"]={BG=Color3.fromRGB(24,6,10),PANEL=Color3.fromRGB(43,12,20),BUTTON=Color3.fromRGB(67,18,29),ACCENT=Color3.fromRGB(255,70,90),TEXT=Color3.fromRGB(255,239,242),MUTED=Color3.fromRGB(245,135,145),ICONBG=Color3.fromRGB(180,35,55),STROKE=Color3.fromRGB(200,40,60)},
	["Dark"]={BG=Color3.fromRGB(10,10,12),PANEL=Color3.fromRGB(21,21,25),BUTTON=Color3.fromRGB(34,34,39),ACCENT=Color3.fromRGB(180,185,195),TEXT=Color3.fromRGB(240,240,245),MUTED=Color3.fromRGB(155,158,168),ICONBG=Color3.fromRGB(85,88,98),STROKE=Color3.fromRGB(100,104,115)},
