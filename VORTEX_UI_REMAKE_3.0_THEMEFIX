local function FlyMiniButton(text,pos,size)
	local b=Instance.new("TextButton")
	b.Size=size or UDim2.fromOffset(72,40)
	b.Position=pos
	b.Text=text
	b.Font=Enum.Font.GothamBold
	b.TextSize=11
	b.AutoButtonColor=false
	b.Parent=FlyController
	Corner(b,9)
	Reg("Buttons",b)
	return b
end

local FlyToggle=FlyMiniButton("✈️ FLY: OFF",UDim2.fromOffset(14,52),UDim2.new(1,-28,0,36))

local FlyUpBtn=FlyMiniButton("⬆ UP",UDim2.fromOffset(14,96))
local FlyDownBtn=FlyMiniButton("⬇ DOWN",UDim2.fromOffset(92,96))
local FlyLeftBtn=FlyMiniButton("◀ LEFT",UDim2.fromOffset(170,96))
local FlyRightBtn=FlyMiniButton("▶ RIGHT",UDim2.fromOffset(248,96),UDim2.fromOffset(48,40))

local FlyBackBtn=FlyMiniButton("◀ BACK",UDim2.fromOffset(53,140),UDim2.fromOffset(82,38))
local FlyForwardBtn=FlyMiniButton("FORWARD ▶",UDim2.fromOffset(145,140),UDim2.fromOffset(112,38))

local FlySpeedMinus=FlyMiniButton("−",UDim2.fromOffset(14,184),UDim2.fromOffset(48,36))
local FlySpeedPlus=FlyMiniButton("+",UDim2.fromOffset(248,184),UDim2.fromOffset(48,36))
local FlyReset=FlyMiniButton("↻ RESET",UDim2.fromOffset(76,184),UDim2.fromOffset(164,36))

local function RefreshFlyController()
	local sliderMode = State.ControlsMode=="SLIDERS"
	FlySpeedMinus.Visible=not sliderMode; FlySpeedPlus.Visible=not sliderMode
	FlyToggle.Text=State.Fly and "✈️ FLY: ON" or "✈️ FLY: OFF"
	FlyStateLabel.Text=(State.Fly and "ON" or "OFF").."  •  SPEED "..State.FlySpeed
	FlyUpBtn.Text=State.FlyUp and "⬆ UP ✓" or "⬆ UP"
	FlyDownBtn.Text=State.FlyDown and "⬇ DOWN ✓" or "⬇ DOWN"
	FlyLeftBtn.Text=State.FlyLeft and "◀ LEFT ✓" or "◀ LEFT"
	FlyRightBtn.Text=State.FlyRight and "▶ RIGHT ✓" or "▶ RIGHT"
	FlyBackBtn.Text=State.FlyBackward and "◀ BACK ✓" or "◀ BACK"
	FlyForwardBtn.Text=State.FlyForward and "FORWARD ▶ ✓" or "FORWARD ▶"
end

FlyToggle.Activated:Connect(function()
	SetFly(not State.Fly)
	RefreshFlyController()
end)

FlyUpBtn.Activated:Connect(function()
	State.FlyUp=not State.FlyUp
	RefreshFlyController()
end)

FlyDownBtn.Activated:Connect(function()
	State.FlyDown=not State.FlyDown
	RefreshFlyController()
end)

FlyLeftBtn.Activated:Connect(function()
	State.FlyLeft=not State.FlyLeft
	RefreshFlyController()
end)

FlyRightBtn.Activated:Connect(function()
	State.FlyRight=not State.FlyRight
	RefreshFlyController()
end)

FlyBackBtn.Activated:Connect(function()
	State.FlyBackward=not State.FlyBackward
	RefreshFlyController()
end)

FlyForwardBtn.Activated:Connect(function()
	State.FlyForward=not State.FlyForward
	RefreshFlyController()
end)

FlySpeedMinus.Activated:Connect(function()
	State.FlySpeed=math.max(10,State.FlySpeed-10)
	RefreshFlyController()
end)

FlySpeedPlus.Activated:Connect(function()
	State.FlySpeed=math.min(500,State.FlySpeed+10)
	RefreshFlyController()
end)

FlyReset.Activated:Connect(function()
	State.FlyUp=false
	State.FlyDown=false
	State.FlyLeft=false
	State.FlyRight=false
	State.FlyForward=false
	State.FlyBackward=false
	State.FlySpeed=70
	SetFly(false)
	RefreshFlyController()
end)

FlyClose.Activated:Connect(function()
	FlyController.Visible=false
end)

-- Dragging for mobile and PC.
local fd=false
local fds
local fsp

FlyTitle.InputBegan:Connect(function(i)
	if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
		fd=true
		fds=i.Position
		fsp=FlyController.Position
		i.Changed:Connect(function()
			if i.UserInputState==Enum.UserInputState.End then fd=false end
		end)
	end
end)

UIS.InputChanged:Connect(function(i)
	if fd and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
		local d=i.Position-fds
		FlyController.Position=UDim2.new(fsp.X.Scale,fsp.X.Offset+d.X,fsp.Y.Scale,fsp.Y.Offset+d.Y)
	end
end)

RefreshFlyController()

local Categories={"PHYSICAL","SPECIAL","FUN","UTILITY","VISUAL","WORLD"}
local CategoryObjects={PHYSICAL={},SPECIAL={},FUN={},UTILITY={},VISUAL={},WORLD={}}
local CategoryButtons={}
local bar=Instance.new("ScrollingFrame"); bar.Name="CategoryBar"; bar.Size=UDim2.new(1,-20,0,42); bar.BackgroundTransparency=1; bar.BorderSizePixel=0; bar.ScrollBarThickness=2; bar.ScrollingDirection=Enum.ScrollingDirection.X; bar.CanvasSize=UDim2.new(0,0,0,0); bar.AutomaticCanvasSize=Enum.AutomaticSize.X; bar.LayoutOrder=1; bar.Parent=ToolsPage
local bl=Instance.new("UIListLayout",bar); bl.FillDirection=Enum.FillDirection.Horizontal; bl.HorizontalAlignment=Enum.HorizontalAlignment.Left; bl.Padding=UDim.new(0,5)
local SelectCategory
local function RegTool(cat,o) table.insert(CategoryObjects[cat],o); return o end
local function ToolLabel(cat,t) local l=Label(ToolsPage,t);l.LayoutOrder=2;return RegTool(cat,l) end
local function ToolButton(cat,t,cb) local b=Button(ToolsPage,t,cb);b.LayoutOrder=3;local d=b:FindFirstChild("ButtonDesc");if d then d.Text="TOOL  •  EQUIP / ACTIVATE" end;return RegTool(cat,b) end

for _,cat in ipairs(Categories) do
	local cb=Instance.new("TextButton")
	cb.Name="Category_"..cat
	cb.Size=UDim2.fromOffset(92,36)
	cb.LayoutOrder=table.find(Categories,cat) or 1
	cb.BackgroundColor3=CategoryInactiveColor()
	cb.Text=cat
	cb.Font=Enum.Font.GothamBold
	cb.TextSize=8
	cb.AutoButtonColor=false
	cb.Parent=bar
	Corner(cb,8)
	local cs=Instance.new("UIStroke",cb)
	cs.Transparency=.55
	cs.Thickness=1
	cs.Color=Accent()
	Reg("Buttons",cb)
	Reg("Strokes",cs)
	CategoryButtons[cat]=cb
end

SelectCategory=function(cat)
	State.CurrentToolCategory=cat
	for _,name in ipairs(Categories) do
		local selected=(name==cat)
		local cb=CategoryButtons[name]
		if cb then
			cb.BackgroundColor3=selected and CategoryActiveColor() or CategoryInactiveColor()
			cb.TextColor3=selected and Color3.new(1,1,1) or ButtonTextColor()
		end
		for _,obj in ipairs(CategoryObjects[name]) do
			if obj and obj.Parent then
				obj.Visible=selected
			end
		end
	end
end

for _,cat in ipairs(Categories) do
	CategoryButtons[cat].Activated:Connect(function()
		SelectCategory(cat)
	end)
end

-- Physical tools
ToolLabel("PHYSICAL","🧰 PHYSICAL TOOLS")
ToolButton("PHYSICAL","📍 TELEPORT TOOL",function()
	local bp=LP:FindFirstChildOfClass("Backpack");if not bp then return end
	local old=bp:FindFirstChild("Vortex Teleport");if old then old:Destroy() end
	local t=Instance.new("Tool");t.Name="Vortex Teleport";t.RequiresHandle=false;t.CanBeDropped=false
	t.Activated:Connect(function() local m=LP:GetMouse();local r=Root();if r and m.Hit then r.CFrame=m.Hit+Vector3.new(0,3,0) end end);t.Parent=bp;Notify("VORTEX","Teleport Tool creada 📍")
end)

local function GiveHoverboard()
	local bp=LP:FindFirstChildOfClass("Backpack")
	if not bp then return end

	for _,x in ipairs({
		bp:FindFirstChild("Vortex Hoverboard"),
		Character() and Character():FindFirstChild("Vortex Hoverboard")
	}) do
		if x then x:Destroy() end
	end

	local t=Instance.new("Tool")
	t.Name="Vortex Hoverboard"
	t.RequiresHandle=true
	t.CanBeDropped=false
	t.ToolTip="3D Hoverboard • R6/R15 • Tap to toggle"

	local h=Instance.new("Part")
	h.Name="Handle"
	h.Size=Vector3.new(.55,.3,1.7)
	h.Material=Enum.Material.Neon
	h.Color=Accent()
	h.Transparency=.08
	h.CanCollide=false; h.CanTouch=false; h.CanQuery=false; h.Massless=true
	h.Parent=t

	local board=nil
	local motor=nil
	local connection=nil
	local active=false
	local elapsed=0
	local lastMove=Vector3.zero
	local controlGui=nil
	local boostUntil=0
	local targetHeight=4.2
	local hoverBaseY=0

	local function makeControls()
		if controlGui then controlGui:Destroy() end
		controlGui=Instance.new("ScreenGui"); controlGui.Name="VortexHoverControls"; controlGui.ResetOnSpawn=false; controlGui.Parent=PG
		local panel=Instance.new("Frame"); panel.Size=UDim2.fromOffset(160,300); panel.Position=UDim2.new(1,-175,0.5,-150); panel.BackgroundColor3=Themes[State.Theme].PANEL; panel.BackgroundTransparency=.08; panel.Parent=controlGui; Corner(panel,14)
		local title=Instance.new("TextLabel"); title.Size=UDim2.new(1,0,0,34); title.BackgroundTransparency=1; title.Text="🛹 HOVERBOARD"; title.TextColor3=Themes[State.Theme].TEXT; title.Font=Enum.Font.GothamBold; title.TextSize=12; title.Parent=panel
		local ps=Instance.new("UIStroke",panel);ps.Color=BorderColor();ps.Transparency=.45;ps.Thickness=1
		local layout=Instance.new("UIListLayout",panel); layout.Padding=UDim.new(0,6); layout.HorizontalAlignment=Enum.HorizontalAlignment.Center; layout.VerticalAlignment=Enum.VerticalAlignment.Center
		local pad=Instance.new("UIPadding",panel); pad.PaddingTop=UDim.new(0,38); pad.PaddingBottom=UDim.new(0,8); pad.PaddingLeft=UDim.new(0,10); pad.PaddingRight=UDim.new(0,10)
		local function cbtn(text,cb) local b=Instance.new("TextButton"); b.Size=UDim2.new(1,0,0,38); b.BackgroundColor3=ButtonBaseColor(); b.TextColor3=ButtonTextColor(); b.Text=text; b.Font=Enum.Font.GothamBold; b.TextSize=11; b.Parent=panel; Corner(b,9); b.Activated:Connect(cb); return b end
		cbtn("⚡ BOOST",function() boostUntil=os.clock()+2 end)
		cbtn("🛹 HOVER",function() targetHeight=4.2; hoverBaseY=(Root() and Root().Position.Y or hoverBaseY) end)
		cbtn("⬆ UP",function() targetHeight=math.min(12,targetHeight+1) end)
		cbtn("⬇ DOWN",function() targetHeight=math.max(1.5,targetHeight-1) end)
		cbtn("⏹ BRAKE",function() lastMove=Vector3.zero; local r2=Root(); if r2 then r2.AssemblyLinearVelocity=Vector3.new(0,r2.AssemblyLinearVelocity.Y,0) end end)
		cbtn("❌ EXIT",function() remove() end)
	end

	local function part(parent,name,size,color,material,cf)
		local p=Instance.new("Part")
		p.Name=name; p.Size=size; p.Color=color; p.Material=material or Enum.Material.SmoothPlastic
		p.CanCollide=false; p.CanTouch=false; p.CanQuery=false; p.Massless=true; p.Anchored=false
		p.CFrame=cf or CFrame.new()
		p.Parent=parent
		return p
	end

	local function weld(a,b)
		local w=Instance.new("WeldConstraint")
		w.Part0=a; w.Part1=b; w.Parent=b
		return w
	end

	local function remove()
		active=false
		if connection then connection:Disconnect(); connection=nil end
		if motor then motor:Destroy(); motor=nil end
		if board then board:Destroy(); board=nil end
		if controlGui then controlGui:Destroy(); controlGui=nil end
	end

	local function createBoard()
		local character=Character(); local r=Root(); local hum=Humanoid()
		if not character or not r or not hum then return false end
		remove()

		board=Instance.new("Model")
		board.Name="VortexHoverboard3D"
		board.Parent=character

		local base=part(board,"Deck",Vector3.new(5.2,.28,1.35),Accent(),Enum.Material.Metal,r.CFrame*CFrame.new(0,-1.65,0))
		local top=part(board,"TopDeck",Vector3.new(4.5,.10,1.05),Color3.fromRGB(25,28,38),Enum.Material.SmoothPlastic,base.CFrame*CFrame.new(0,.19,0))
		local core=part(board,"EnergyCore",Vector3.new(3.0,.10,.18),Accent(),Enum.Material.Neon,base.CFrame*CFrame.new(0,.27,0))
		local nose=part(board,"Nose",Vector3.new(.28,.36,1.5),Accent(),Enum.Material.Neon,base.CFrame*CFrame.new(2.48,.02,0))
		local tail=part(board,"Tail",Vector3.new(.28,.36,1.5),Accent(),Enum.Material.Neon,base.CFrame*CFrame.new(-2.48,.02,0))

		local rootPart=base
		for _,obj in ipairs(board:GetChildren()) do
			if obj:IsA("BasePart") and obj~=rootPart then weld(rootPart,obj) end
		end

		for _,x in ipairs({-1.65,1.65}) do
			local motorHousing=part(board,"Motor",Vector3.new(.48,.38,.9),Color3.fromRGB(35,38,48),Enum.Material.Metal,base.CFrame*CFrame.new(x,-.38,0))
			weld(rootPart,motorHousing)
			local glow=part(board,"WheelGlow",Vector3.new(.62,.18,.62),Accent(),Enum.Material.Neon,base.CFrame*CFrame.new(x,-.62,0)*CFrame.Angles(math.rad(90),0,0))
			glow.Shape=Enum.PartType.Cylinder
			weld(rootPart,glow)
		end

		motor=Instance.new("Motor6D")
		motor.Name="VortexHoverboardMotor"
		motor.Part0=r
		motor.Part1=rootPart
		motor.C0=CFrame.new(0,-1.65,0)
		motor.Parent=r

		active=true; elapsed=0; lastMove=Vector3.zero; targetHeight=4.2; hoverBaseY=r.Position.Y; makeControls()

		connection=RunService.Heartbeat:Connect(function(dt)
			if not active or not board or not board.Parent or not r.Parent then return end
			elapsed += dt
			local move=hum.MoveDirection
			local horizontal=Vector3.new(move.X,0,move.Z)
			local moving=horizontal.Magnitude>.05
			if moving then
				horizontal=horizontal.Unit*State.HoverSpeed*(os.clock()<boostUntil and 2 or 1)
				lastMove=horizontal
			else
				lastMove=lastMove*.90
			end

			-- Mantiene al jugador elevado: el hoverboard NO toca el suelo.
			-- El ascenso es suave y se corrige continuamente si cae.
			local desiredY=hoverBaseY+targetHeight
			local verticalError=desiredY-r.Position.Y
			local yVelocity=math.clamp(verticalError*8-r.AssemblyLinearVelocity.Y*2, -35, 35)
			r.AssemblyLinearVelocity=Vector3.new(lastMove.X,yVelocity,lastMove.Z)

			local bob=math.sin(elapsed*8)*.07
			local roll=moving and math.sin(elapsed*10)*math.rad(5) or 0
			local pitch=moving and math.rad(3) or 0
			motor.Transform=CFrame.new(0,bob,0)*CFrame.Angles(pitch,0,roll)

			for _,obj in ipairs(board:GetDescendants()) do
				if obj:IsA("BasePart") and (obj.Name=="EnergyCore" or obj.Name=="Nose" or obj.Name=="Tail" or obj.Name=="WheelGlow") then
					obj.Color=Accent()
				end
			end
		end)
		return true
	end

	t.Activated:Connect(function()
		if active then
			remove()
			Notify("VORTEX","Hoverboard desactivada 🛹")
		else
			if createBoard() then Notify("VORTEX","Hoverboard 3D activada • "..State.HoverSpeed.." ⚡🛹") end
		end
	end)
	t.Unequipped:Connect(function() remove() end)
	t.Destroying:Connect(remove)
	t.Parent=bp
	Notify("VORTEX","Hoverboard 3D añadida a tu mochila 🛹")
end

ToolButton("PHYSICAL","🛹 HOVERBOARD • GIVE TOOL",GiveHoverboard)

ToolButton("PHYSICAL","🪝 GRAPPLING HOOK",function()
	local bp=LP:FindFirstChildOfClass("Backpack");if not bp then return end
	local old=bp:FindFirstChild("Vortex Grappling Hook") or (Character() and Character():FindFirstChild("Vortex Grappling Hook"));if old then old:Destroy() end
	local t=Instance.new("Tool");t.Name="Vortex Grappling Hook";t.RequiresHandle=true;t.CanBeDropped=false;t.ToolTip="Lanza un gancho • Saltar cancela"
	local h=Instance.new("Part");h.Name="Handle";h.Size=Vector3.new(.35,.35,1.35);h.Material=Enum.Material.Metal;h.Color=Color3.fromRGB(55,55,65);h.CanCollide=false;h.Massless=true;h.Parent=t
	local ring=Instance.new("Part");ring.Size=Vector3.new(.65,.65,.22);ring.Material=Enum.Material.Neon;ring.Color=Accent();ring.CanCollide=false;ring.Massless=true;ring.Parent=t
	local weld=Instance.new("WeldConstraint",ring);weld.Part0=h;weld.Part1=ring;ring.CFrame=h.CFrame*CFrame.new(0,0,-.65)
	local active=false;local line;local projectile;local jumpConn
	local function cancel()
		active=false;if line then line:Destroy();line=nil end;if projectile then projectile:Destroy();projectile=nil end;if jumpConn then jumpConn:Disconnect();jumpConn=nil end
	end
	t.Unequipped:Connect(cancel);t.Destroying:Connect(cancel)
	t.Activated:Connect(function()
		local r=Root();local m=LP:GetMouse();if not r or not m.Hit then return end
		cancel();active=true
		projectile=Instance.new("Part");projectile.Shape=Enum.PartType.Ball;projectile.Size=Vector3.new(.55,.55,.55);projectile.Material=Enum.Material.Neon;projectile.Color=Accent();projectile.CanCollide=false;projectile.CanTouch=false;projectile.CanQuery=false;projectile.Anchored=true;projectile.Parent=workspace
		local a0=Instance.new("Attachment",h);local a1=Instance.new("Attachment",projectile)
		line=Instance.new("Beam");line.Attachment0=a0;line.Attachment1=a1;line.Width0=.08;line.Width1=.05;line.FaceCamera=true;line.Color=ColorSequence.new(Accent());line.Parent=workspace
		local target=m.Hit.Position;local startPos=h.Position;local travel=0;local duration=math.max(.15,(target-startPos).Magnitude/180)
		jumpConn=UIS.JumpRequest:Connect(cancel)
		task.spawn(function()
			local t0=os.clock()
			while active and projectile and projectile.Parent do
				local p=math.clamp((os.clock()-t0)/duration,0,1);local pos=startPos:Lerp(target,p);projectile.CFrame=CFrame.new(pos)
				if p>=1 then break end
				RunService.RenderStepped:Wait()
			end
			if not active then return end
			-- Stay attached at the destination until the player jumps or the tool is cancelled.
			while active and projectile and projectile.Parent and r.Parent do
				local d=target-r.Position
				if d.Magnitude>4 then r.AssemblyLinearVelocity=d.Unit*math.min(d.Magnitude*5,180) else r.AssemblyLinearVelocity=Vector3.new(0,r.AssemblyLinearVelocity.Y,0) end
				RunService.Heartbeat:Wait()
			end
		end)
	end)
	t.Parent=bp;Notify("VORTEX","Grappling Hook creada 🪝")
end)

