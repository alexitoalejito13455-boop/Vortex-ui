local Prev=SBtn("<",UDim2.fromOffset(6,38));local Next=SBtn(">",UDim2.new(1,-42,0,38));local Reset=SBtn("↻",UDim2.fromOffset(6,4));local Exit=SBtn("×",UDim2.new(1,-42,0,4))

local sd=false;local sds;local ssp
