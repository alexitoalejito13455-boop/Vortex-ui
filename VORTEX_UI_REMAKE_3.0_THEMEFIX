Profiles.Hover=Profiles.Hover or {Speed=16,JumpPower=50,FlySpeed=70,HoverSpeed=80,BodySize="NORMAL",BodyShape="NORMAL",Theme="Vortex Blue",Scale=1,Transparency=.06,RGB=true}
Profiles.Physics=Profiles.Physics or {Speed=35,JumpPower=100,FlySpeed=100,HoverSpeed=60,BodySize="BIG",BodyShape="NORMAL",Theme="Purple",Scale=1,Transparency=.06,RGB=false}
Profiles.Fun=Profiles.Fun or {Speed=40,JumpPower=100,FlySpeed=90,HoverSpeed=70,BodySize="SMALL",BodyShape="FAT",Theme="Cyan",Scale=1,Transparency=.06,RGB=true}

