local Registry={Buttons={},Labels={},TextBoxes={},Strokes={},Panels={},AccentLabels={},Icons={},AccentFrames={}}
local function Reg(k,o) table.insert(Registry[k],o); return o end

-- Card-style button helpers: visual, compact and mobile-friendly.
local function ButtonIcon(text)
	local first=text:match("^(%S+)") or "◆"
	if first:find("^[%w%p]+$") then
		local map={
			["SPEED"]="⚡",["JUMP"]="🦘",["FLY"]="✈",["FPS:"]="◈",["PLAYERS:"]="♟",
			["SESSION:"]="◷",["INPUT:"]="⌨",["SIZE"]="↔",["THEME:"]="🎨",["DEBUG"]="🐞",
			["CLEAR"]="🧹",["MOBILE"]="📱",["PC"]="🖥",["VORTEX"]="V",["RGB:"]="🌈"
		}
		return map[first] or "◆"
	end
	return first
end

local function SetButtonText(button,text)
	if not button then return end
	button.Text=text -- kept for search/accessibility
	local title=button:FindFirstChild("ButtonTitle")
	if title then
		local icon=text:match("^(%S+)") or "◆"
		local rest=text:gsub("^%S+%s*","")
		if rest=="" then rest=text end
		title.Text=rest
		local iconLabel=button:FindFirstChild("ButtonIcon")
		if iconLabel then iconLabel.Text=ButtonIcon(text) end
	end
end

