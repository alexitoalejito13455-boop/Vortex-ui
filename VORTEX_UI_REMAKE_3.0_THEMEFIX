local function SpectatorPlayers()
	local a={};for _,p in ipairs(Players:GetPlayers())do if p~=LP then table.insert(a,p)end end
	table.sort(a,function(x,y)return x.Name:lower()<y.Name:lower()end);return a
end
local function Spectate(p)
	local c=p and p.Character;local h=c and c:FindFirstChildOfClass("Humanoid");if not h then return end
	State.SpectatorTarget=p;workspace.CurrentCamera.CameraType=Enum.CameraType.Custom;workspace.CurrentCamera.CameraSubject=h;SN.Text=p.DisplayName.."  @"..p.Name
end
local function SpectatorIndex(i)
	local a=SpectatorPlayers();if #a==0 then SN.Text="No hay jugadores";return end
	if i<1 then i=#a end;if i>#a then i=1 end;State.SpectatorIndex=i;Spectate(a[i])
end
local function StopSpectator()
	State.Spectator=false;State.SpectatorTarget=nil;State.SpectatorIndex=0;SG.Visible=false
	local h=Humanoid();workspace.CurrentCamera.CameraType=Enum.CameraType.Custom;if h then workspace.CurrentCamera.CameraSubject=h end
end
local function StartSpectator()
	local a=SpectatorPlayers();if #a==0 then Notify("SPECTATOR","No hay otros jugadores");return end
	State.Spectator=true;SG.Visible=true;SpectatorIndex(1);Notify("SPECTATOR","Modo espectador activado 👁")
end
Prev.Activated:Connect(function()if State.Spectator then SpectatorIndex(State.SpectatorIndex-1)end end)
Next.Activated:Connect(function()if State.Spectator then SpectatorIndex(State.SpectatorIndex+1)end end)
Reset.Activated:Connect(function()local h=Humanoid();workspace.CurrentCamera.CameraType=Enum.CameraType.Custom;if h then workspace.CurrentCamera.CameraSubject=h end;State.SpectatorTarget=nil;SN.Text="Tu personaje" end)
Exit.Activated:Connect(StopSpectator)
Players.PlayerRemoving:Connect(function(p)if p==State.SpectatorTarget and State.Spectator then local a=SpectatorPlayers();if #a>0 then SpectatorIndex(math.min(State.SpectatorIndex,#a))else StopSpectator()end end end)

-- assign spectator button (the last visual button)
for _,o in ipairs(CategoryObjects.VISUAL) do
	if o:IsA("TextButton") and o.Text=="👁 SPECTATOR" then o.Activated:Connect(StartSpectator) end
end

