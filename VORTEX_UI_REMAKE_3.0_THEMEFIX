	for _,o in ipairs({WalkMinus,WalkPlus,JumpMinus,JumpPlus,FlyMinusCfg,FlyPlusCfg,HoverMinus,HoverPlus,ScaleMinus,ScalePlus}) do o.Visible=not sliders end
	FlySpeedMinus.Visible=not sliders; FlySpeedPlus.Visible=not sliders
end
