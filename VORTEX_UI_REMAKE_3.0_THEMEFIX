local SN=Instance.new("TextLabel");SN.BackgroundTransparency=1;SN.Position=UDim2.fromOffset(45,29);SN.Size=UDim2.new(1,-90,0,18);SN.Text="Selecciona un jugador";SN.Font=Enum.Font.GothamSemibold;SN.TextSize=11;SN.TextTruncate=Enum.TextTruncate.AtEnd;SN.Parent=SG;Reg("Labels",SN)
