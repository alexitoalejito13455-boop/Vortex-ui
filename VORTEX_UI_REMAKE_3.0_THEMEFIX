local FlyAttachment,FlyVelocity
local FlyTool
local function StopFly()
	if FlyVelocity then FlyVelocity:Destroy();FlyVelocity=nil end
	if FlyAttachment then FlyAttachment:Destroy();FlyAttachment=nil end
end
local function StartFly()
	local r=Root(); if not r then return end
	StopFly()
	FlyAttachment=Instance.new("Attachment",r); FlyAttachment.Name="VortexFlyAttachment"
	FlyVelocity=Instance.new("LinearVelocity",r); FlyVelocity.Name="VortexFlyVelocity"; FlyVelocity.Attachment0=FlyAttachment; FlyVelocity.RelativeTo=Enum.ActuatorRelativeTo.World; FlyVelocity.MaxForce=math.huge; FlyVelocity.VectorVelocity=Vector3.zero
end
local function SetFly(v)
	State.Fly=v
	if v then
		StartFly()
	else
		StopFly()
		local r=Root()
		if r then r.AssemblyLinearVelocity=Vector3.zero end
	end
end

local function FlyDirection()
	local cam=workspace.CurrentCamera;if not cam then return Vector3.zero end
	local d=Vector3.zero
	if State.FlyForward then d+=cam.CFrame.LookVector end
	if State.FlyBackward then d-=cam.CFrame.LookVector end
	if State.FlyRight then d+=cam.CFrame.RightVector end
	if State.FlyLeft then d-=cam.CFrame.RightVector end
	if State.FlyUp then d+=Vector3.yAxis end
	if State.FlyDown then d-=Vector3.yAxis end
	return d.Magnitude>0 and d.Unit or Vector3.zero
end

